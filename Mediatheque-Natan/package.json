{
  "name": "mediatheque-natan",
  "version": "1.0.0",
  "description": "Médiathèque NATAN - Gestion intelligente de CDs, DVDs et Blu-rays avec profilage utilisateur et recommandations",
  "author": "Nathalie FALSIMAGNE - NATAN Consulting",
  "license": "Proprietary",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n main,renderer,electron -c blue,green,magenta \"npm:watch:main\" \"npm:start:renderer\" \"npm:start:electron\"",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "watch:main": "cross-env NODE_ENV=development webpack --config webpack.main.config.js --watch",
    "start:renderer": "cross-env NODE_ENV=development webpack serve --config webpack.renderer.config.js",
    "start:electron": "wait-on dist/main.js tcp:3000 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "cross-env NODE_ENV=production webpack --config webpack.main.config.js",
    "build:renderer": "cross-env NODE_ENV=production webpack --config webpack.renderer.config.js",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "eslint app/src --ext .js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "sync-external": "node scripts/sync-external.js"
  },
  "build": {
    "appId": "com.natan.mediatheque",
    "productName": "Médiathèque NATAN",
    "directories": {
      "app": "dist",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "app/public/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "app/public/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "app/public/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "app/public/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": ["AppImage", "deb", "snap"],
      "icon": "app/public/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "snap": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@electron/remote": "^2.1.0",
    "@tensorflow-models/mobilenet": "^2.0.0",
    "@tensorflow/tfjs": "^4.15.0",
    "@zxing/browser": "^0.1.4",
    "@zxing/library": "^0.21.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.1",
    "csv-parser": "^3.0.0",
    "express": "^4.19.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "electron-store": "^8.1.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "lucide-react": "^0.323.0",
    "mini-css-extract-plugin": "^2.8.1",
    "postcss": "^8.4.35",
    "postcss-loader": "^8.1.1",
    "postcss-preset-mantine": "^1.15.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "recharts": "^2.10.4",
    "sass": "^1.71.0",
    "sass-loader": "^14.1.0",
    "selfsigned": "^2.4.1",
    "sqlite3": "^5.1.7",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "url-loader": "^4.1.1",
    "uuid": "^9.0.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-router-dom": "^5.3.3",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.0",
    "events": "^3.3.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "node-loader": "^2.0.0",
    "ts-node": "^10.9.2",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "tesseract.js": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "mediatheque",
    "natan",
    "cd",
    "dvd",
    "blu-ray",
    "media",
    "library",
    "management",
    "recommendation",
    "electron",
    "offline"
  ],
  "homepage": "https://www.natan-consulting.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathaliefalsimagne-ops/mistral/tree/main/Mediatheque-Natan"
  },
  "bugs": {
    "url": "https://github.com/nathaliefalsimagne-ops/mistral/issues"
  }
}
